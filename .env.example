# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="CodeImpact"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretdevelopmentkeypleasereplaceinproduction"

# Server Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=codeimpact
POSTGRES_PASSWORD=codeimpact_dev_password
POSTGRES_DB=codeimpact_db
DATABASE_URL=postgresql+asyncpg://codeimpact:codeimpact_dev_password@localhost:5432/codeimpact_db
SYNC_DATABASE_URL=postgresql+psycopg2://codeimpact:codeimpact_dev_password@localhost:5432/codeimpact_db

# Redis & RQ Worker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=codeimpact_analysis

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET="development_webhook_secret_key"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# MLflow Tracking
MLFLOW_TRACKING_URI=./mlruns
ML_MODEL_ARTIFACTS_PATH=./backend/app/ml/models_store

# Storage & Temporary Checkouts
WORKSPACE_STORAGE_PATH=/tmp/codeimpact_snapshots
